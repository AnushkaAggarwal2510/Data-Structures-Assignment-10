Question 1) Write a program to represent a graph using adjacency matrix/list and perform basic operations like degree (in/out) of a vertex, adjacent vertices, number of edges, etc. 

Answer 1)

#include <iostream>
#include <vector>
using namespace std;

class Graph {
private:
    int n, directed;
    vector<vector<int>> matrix;
    vector<vector<int>> adjList;

public:
    Graph(int vertices, int isDirected) {
        n = vertices;
        directed = isDirected;
        matrix.assign(n, vector<int>(n, 0));
        adjList.assign(n, vector<int>());
    }
    void addEdge(int u, int v) {
        matrix[u][v] = 1;
        adjList[u].push_back(v);

        if (!directed) {   
            matrix[v][u] = 1;
            adjList[v].push_back(u);
        }
    }
    void displayMatrix() {
        cout << "\nAdjacency Matrix:\n";
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++)
                cout << matrix[i][j] << " ";
            cout << endl;
        }
    }
    void displayList() {
        cout << "\nAdjacency List:\n";
        for (int i = 0; i < n; i++) {
            cout << i << " -> ";
            for (int v : adjList[i])
                cout << v << " ";
            cout << endl;
        }
    }
    int degree(int v) {
        return adjList[v].size();
    }
    int inDegree(int v) {
        int cnt = 0;
        for (int i = 0; i < n; i++)
            if (matrix[i][v] == 1)
                cnt++;
        return cnt;
    }
    int outDegree(int v) {
        return adjList[v].size();
    }
    void adjacentVertices(int v) {
        cout << "Adjacent vertices of " << v << ": ";
        for (int x : adjList[v])
            cout << x << " ";
        cout << endl;
    }
    int edgeCount() {
        int count = 0;

        if (directed) {
            for (int i = 0; i < n; i++)
                for (int j = 0; j < n; j++)
                    if (matrix[i][j] == 1)
                        count++;
        } else {
            for (int i = 0; i < n; i++)
                for (int j = i; j < n; j++)
                    if (matrix[i][j] == 1)
                        count++;
        }
        return count;
    }
};
int main() {
    int n, directed;
    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Is the graph directed? (1=Yes, 0=No): ";
    cin >> directed;

    Graph g(n, directed);

    int choice, u, v;

    while (true) {
        cout << "\n---- GRAPH MENU ----";
        cout << "\n1. Add Edge";
        cout << "\n2. Display Adjacency Matrix";
        cout << "\n3. Display Adjacency List";
        cout << "\n4. Degree of a Vertex";
        cout << "\n5. In-degree of a Vertex";
        cout << "\n6. Out-degree of a Vertex";
        cout << "\n7. Adjacent Vertices";
        cout << "\n8. Number of Edges";
        cout << "\n9. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter edge (u v): ";
                cin >> u >> v;
                g.addEdge(u, v);
                break;

            case 2:
                g.displayMatrix();
                break;

            case 3:
                g.displayList();
                break;

            case 4:
                cout << "Enter vertex: ";
                cin >> u;
                cout << "Degree = " << g.degree(u) << endl;
                break;

            case 5:
                cout << "Enter vertex: ";
                cin >> u;
                cout << "In-degree = " << g.inDegree(u) << endl;
                break;

            case 6:
                cout << "Enter vertex: ";
                cin >> u;
                cout << "Out-degree = " << g.outDegree(u) << endl;
                break;

            case 7:
                cout << "Enter vertex: ";
                cin >> u;
                g.adjacentVertices(u);
                break;

            case 8:
                cout << "Number of edges = " << g.edgeCount() << endl;
                break;

            case 9:
                return 0;

            default:
                cout << "Invalid choice!\n";
        }
    }
}
